   <property name="styleSheet">
    <string notr="true">QWidget#centralwidget {
    background-color: #1e1e1e;
}

/* 显示屏：右对齐、白字、无边框 */
QLineEdit#display {
    background-color: #1e1e1e;
    color: white;
    border: none;
    font-size: 32px;
    font-weight: bold;
    padding-right: 12px;
}

/* 数字键：深灰圆角 */
QPushButton#btnNum0, QPushButton#btnNum1, QPushButton#btnNum2,
QPushButton#btnNum3, QPushButton#btnNum4, QPushButton#btnNum5,
QPushButton#btnNum6, QPushButton#btnNum7, QPushButton#btnNum8,
QPushButton#btnNum9, QPushButton#btnSign, QPushButton#btnDot {
    background-color: #333333;
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 22px;
    font-weight: bold;
}
QPushButton#btnNum0:hover, QPushButton#btnNum1:hover, QPushButton#btnNum2:hover,
QPushButton#btnNum3:hover, QPushButton#btnNum4:hover, QPushButton#btnNum5:hover,
QPushButton#btnNum6:hover, QPushButton#btnNum7:hover, QPushButton#btnNum8:hover,
QPushButton#btnNum9:hover, QPushButton#btnSign:hover, QPushButton#btnDot:hover {
    background-color: #555555;
}
QPushButton#btnNum0:pressed, QPushButton#btnNum1:pressed, QPushButton#btnNum2:pressed,
QPushButton#btnNum3:pressed, QPushButton#btnNum4:pressed, QPushButton#btnNum5:pressed,
QPushButton#btnNum6:pressed, QPushButton#btnNum7:pressed, QPushButton#btnNum8:pressed,
QPushButton#btnNum9:pressed, QPushButton#btnSign:pressed, QPushButton#btnDot:pressed {
    background-color: #777777;
}

/* 二元操作符与等号：橙色 */
QPushButton#btnPlus, QPushButton#btnMinus,
QPushButton#btnMultiple, QPushButton#btnDivide, QPushButton#btnEqual {
    background-color: #ff9500;
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 24px;
    font-weight: bold;
}
QPushButton#btnPlus:hover, QPushButton#btnMinus:hover,
QPushButton#btnMultiple:hover, QPushButton#btnDivide:hover, QPushButton#btnEqual:hover {
    background-color: #ffaa33;
}
QPushButton#btnPlus:pressed, QPushButton#btnMinus:pressed,
QPushButton#btnMultiple:pressed, QPushButton#btnDivide:pressed, QPushButton#btnEqual:pressed {
    background-color: #cc7700;
}

/* 一元操作符：浅灰 */
QPushButton#btnPercentage, QPushButton#btnInverse,
QPushButton#btnSquare, QPushButton#btnSqrt {
    background-color: #a5a5a5;
    color: black;
    border: none;
    border-radius: 6px;
    font-size: 18px;
    font-weight: bold;
}
QPushButton#btnPercentage:hover, QPushButton#btnInverse:hover,
QPushButton#btnSquare:hover, QPushButton#btnSqrt:hover {
    background-color: #bbbbbb;
}
QPushButton#btnPercentage:pressed, QPushButton#btnInverse:pressed,
QPushButton#btnSquare:pressed, QPushButton#btnSqrt:pressed {
    background-color: #888888;
}

/* 工具键 CE C ⌫：浅灰 */
QPushButton#btnCE, QPushButton#btnClear, QPushButton#btnDel {
    background-color: #a5a5a5;
    color: black;
    border: none;
    border-radius: 6px;
    font-size: 18px;
    font-weight: bold;
}
QPushButton#btnCE:hover, QPushButton#btnClear:hover, QPushButton#btnDel:hover {
    background-color: #bbbbbb;
}
QPushButton#btnCE:pressed, QPushButton#btnClear:pressed, QPushButton#btnDel:pressed {
    background-color: #888888;
}</string>
